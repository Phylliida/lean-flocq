set_option maxHeartbeats 800000 in
theorem killsData1_empty : ∀ x ∈ killsData1,
    ¬ ∃ ω, IsTiling (relOfHeld (heldOfNat x.2)) ω := by
  intro x hx
  exact killOk_sound _ _
    (Array.all_eq_true_iff_forall_mem.mp killsData1_verified x hx)

end AnyK3D
