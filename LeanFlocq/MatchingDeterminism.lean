def pairAllowed (M : List (Pt × Pt)) (a b : Pt) : Bool :=
  a != b && (M.contains (a, b) || M.contains (b, a))

/-- (ax, o₁, o₂) is compat_M-allowed: all nine decoration point-pairs
across the interface lie in the matching, non-degenerately. -/
def allowed (M : List (Pt × Pt)) (ax : Nat) (o1 o2 : Mat) : Bool :=
  (iface ax).all fun (w1, w2) =>
    pairAllowed M (mvec (tr o1) w1) (mvec (tr o2) w2)

def succCount (M : List (Pt × Pt)) (ax : Nat) (o1 : Mat) : Nat :=
  (rots.filter (fun o2 => allowed M ax o1 o2)).length

def predCount (M : List (Pt × Pt)) (ax : Nat) (o2 : Mat) : Nat :=
  (rots.filter (fun o1 => allowed M ax o1 o2)).length

def deterministicB (M : List (Pt × Pt)) : Bool :=
  [0, 1, 2].all fun ax =>
    rots.all fun o =>
      succCount M ax o ≤ 1 && predCount M ax o ≤ 1

def perfectB (M : List (Pt × Pt)) : Bool :=
  M.length == 27 &&
  pts.all fun p =>
    (M.filter (fun (a, b) => a == p || b == p)).length == 1

/-- Every one of the fourteen catalogue patterns is a perfect
matching on the 54 surface points. -/
theorem matchings_perfect : matchings.all perfectB = true := by
  decide

/-- **Theorem 5(a), concrete:** each matching pattern induces a
deterministic compatibility relation: at most one successor and at
most one predecessor along every axis. -/
theorem matchings_deterministic :
    matchings.all deterministicB = true := by
  native_decide

/-- Face rigidity (the geometric heart of the pencil proof of 5(a)):
two rotations agreeing on all nine points of a −ax face coincide. -/
theorem face_rigidity :
    ([0, 1, 2].all fun ax =>
      rots.all fun o1 => rots.all fun o2 =>
        !((iface ax).all fun (_, w2) =>
            mvec (tr o1) w2 == mvec (tr o2) w2) || o1 == o2) = true := by
  decide

/-- Sanity: the generator really produces 24 rotations. -/
theorem rots_card : rots.length = 24 := by decide

end MatchingDet
